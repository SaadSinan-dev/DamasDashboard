# ── Dart / Flutter ───────────────────────────────────────────────────────────
.dart_tool/
.packages
.pub-cache/
.pub/
build/
.flutter-plugins
.flutter-plugins-dependencies
**/doc/api/
**/ios/Flutter/.last_build_id
migrate_working_dir/

# Generated by `flutter gen-l10n`, which `flutter pub get` runs automatically
# because `generate: true` is set in pubspec.yaml. Committing it would mean
# reviewing a diff of machine output on every string change.
lib/core/l10n/generated/

# Other code generation, should the project adopt it.
*.g.dart
*.freezed.dart
*.mocks.dart

# Test artefacts
coverage/
test/**/failures/

# Symbolication and obfuscation
app.*.symbols
app.*.map.json

# ── Secrets and local configuration ──────────────────────────────────────────
# Never commit credentials. Runtime configuration is passed with --dart-define
# (see lib/core/config/app_config.dart).
*.env
.env*
!.env.example
android/key.properties
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
lib/firebase_options.dart
**/*.jks
**/*.keystore

# ── Platform build systems ───────────────────────────────────────────────────
android/local.properties
android/.gradle/
android/captures/
android/app/debug/
android/app/profile/
android/app/release/
android/.cxx/

ios/Flutter/flutter_export_environment.sh
ios/Flutter/Generated.xcconfig
ios/Pods/
ios/.symlinks/
**/Flutter/App.framework/
**/Flutter/Flutter.framework/
**/Flutter/Flutter.podspec

macos/Pods/
macos/Flutter/ephemeral/
linux/flutter/ephemeral/
windows/flutter/ephemeral/

# ── Firebase Hosting ─────────────────────────────────────────────────────────
# Deploy cache; .firebaserc holds the project alias and is intentionally kept.
.firebase/

# ── IDE and editor ───────────────────────────────────────────────────────────
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.swp
.history

